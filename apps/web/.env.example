# Server-only URL used by Server Components, Auth.js and route handlers.
API_INTERNAL_URL="http://localhost:4000/api"

# Auth.js server-only values. Never prefix secrets with NEXT_PUBLIC_.
AUTH_SECRET="replace-with-a-unique-random-secret-of-at-least-32-characters"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

AUTH_REFRESH_COOKIE_NAME="stu_refresh_token"
AUTH_COOKIE_SAME_SITE="lax"
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_PATH="/api/auth"
# AUTH_COOKIE_DOMAIN=""

# Used only when the proxy does not provide a country header (for example local dev).
VISITOR_COUNTRY_FALLBACK="VN"
