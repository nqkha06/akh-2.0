{
  "name": "@stu/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && nest start --watch",
    "dev:worker": "prisma generate && ts-node -r tsconfig-paths/register src/worker.ts",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "TS_NODE_PROJECT=tsconfig.test.json node --test -r ts-node/register test/auth.e2e-spec.ts",
    "test:e2e": "TS_NODE_PROJECT=tsconfig.test.json node --test -r ts-node/register test/auth.e2e-spec.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/client": "^6.19.3",
    "@stu/contracts": "workspace:*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "google-auth-library": "^10.9.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@stu/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.1",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/sanitize-html": "^2.16.1",
    "dotenv": "^17.2.3",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
