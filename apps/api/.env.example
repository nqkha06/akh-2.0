NODE_ENV="development"
API_PORT=4000
DATABASE_URL="file:./dev.db"
FRONTEND_ORIGIN="http://localhost:3000,http://localhost:3100"
PASSWORD_RESET_URL="http://localhost:3000/reset-password"
PASSWORD_RESET_TOKEN_TTL_MINUTES="30"

# SMTP gửi email đặt lại mật khẩu. Bắt buộc cấu hình trong production.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Website <no-reply@example.com>"

# Amazon SES Email Operations Center. Credentials chỉ được cấu hình server-side.
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SES_SNS_TOPIC_ARNS=""
EMAIL_DEBUG_MODE="false"

# Mặc định bật ngoài production và tắt trong production.
# Đặt true rõ ràng nếu cần dùng Swagger trên môi trường production được bảo vệ.
SWAGGER_ENABLED="true"

JWT_ACCESS_SECRET="replace-with-a-unique-random-secret-of-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-another-unique-random-secret-of-at-least-32-characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

AUTH_GOOGLE_ID=""
AUTH_ACCESS_COOKIE_NAME="stu_access_token"
AUTH_REFRESH_COOKIE_NAME="stu_refresh_token"
AUTH_COOKIE_SAME_SITE="lax"
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_PATH="/"
# AUTH_COOKIE_DOMAIN=""

MEMBER_FILES_UPLOAD_DIR="uploads/member-files"
SUPPORT_TICKETS_UPLOAD_DIR="uploads"

# Redis/BullMQ. Dùng Redis riêng trong production; DB 2 chỉ là mặc định local.
QUEUE_ENABLED="true"
QUEUE_PREFIX="stu-v2"
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_DB="2"
REDIS_USERNAME=""
REDIS_PASSWORD=""
REDIS_TLS="false"

# Visit aggregation queue tuning.
VISIT_AGGREGATION_DISABLED="false"
VISIT_AGGREGATION_INTERVAL_MS="60000"
VISIT_AGGREGATION_BATCH_SIZE="1000"
VISIT_AGGREGATION_MAX_BATCHES_PER_JOB="20"
LOYALTY_ROLLUP_DISABLED="false"
LOYALTY_ROLLUP_CRON="0 0 * * *"

# System Logs: cleanup retention chạy trên queue riêng mỗi 24 giờ.
SYSTEM_LOG_CLEANUP_DISABLED="false"
SYSTEM_LOG_CLEANUP_INTERVAL_MS="86400000"
