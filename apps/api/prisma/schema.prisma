generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int                       @id @default(autoincrement())
  name                     String
  email                    String                    @unique
  emailVerifiedAt          DateTime?                 @map("email_verified_at")
  passwordHash             String?                   @map("password")
  avatar                   String?
  status                   String                    @default("active")
  balance                  Decimal                   @default(0)
  referralCode             String?                   @unique @map("referral_code")
  referredById             Int?                      @map("referred_by")
  tokenVersion             Int                       @default(0) @map("token_version")
  monetizationLevelId      Int?                      @map("monetization_level_id")
  loyaltyTierId            Int?                      @map("loyalty_tier_id")
  loyaltyValidViews        Int                       @default(0) @map("loyalty_valid_views")
  loyaltyWindowStartedAt   DateTime?                 @map("loyalty_window_started_at")
  loyaltyWindowEndedAt     DateTime?                 @map("loyalty_window_ended_at")
  loyaltyCalculatedAt      DateTime?                 @map("loyalty_calculated_at")
  storageLimitBytes        BigInt?                   @map("storage_limit_bytes")
  storageUsedBytes         BigInt                    @default(0) @map("storage_used_bytes")
  storageReservedBytes     BigInt                    @default(0) @map("storage_reserved_bytes")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  socialAccounts           SocialAccount[]
  authSessions             AuthSession[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  links                    Link[]
  snippets                 Snippet[]
  memberFiles              MemberFile[]
  memberFileUploads        MemberFileUpload[]
  roles                    UserHasRole[]
  permissions              UserHasPermission[]
  monetizationLevel        MonetizationLevel?        @relation(fields: [monetizationLevelId], references: [id], onDelete: Restrict)
  loyaltyTier              LoyaltyTier?              @relation(fields: [loyaltyTierId], references: [id], onDelete: SetNull)
  paymentMethods           UserPaymentMethod[]
  withdrawals              UserWithdrawal[]          @relation("MemberWithdrawals")
  processedWithdrawals     UserWithdrawal[]          @relation("ProcessedWithdrawals")
  referrer                 User?                     @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals                User[]                    @relation("UserReferrals")
  commissionsReceived      Commission[]              @relation("CommissionRecipient")
  commissionsGenerated     Commission[]              @relation("CommissionSource")
  updatedWebsiteSettings   WebsiteSettings[]         @relation("WebsiteSettingsUpdatedBy")
  updatedBusinessSettings  BusinessSettings[]        @relation("BusinessSettingsUpdatedBy")
  uploadedAdminMedia       AdminMedia[]              @relation("AdminMediaUploadedBy")
  createdAdminMediaFolders AdminMediaFolder[]        @relation("AdminMediaFolderCreatedBy")
  createdWebsiteMenus      WebsiteMenu[]             @relation("WebsiteMenuCreatedBy")
  updatedWebsiteMenus      WebsiteMenu[]             @relation("WebsiteMenuUpdatedBy")
  updatedMenuLocations     WebsiteMenuLocation[]     @relation("WebsiteMenuLocationUpdatedBy")
  supportTickets           SupportTicket[]           @relation("SupportTicketOwner")
  assignedSupportTickets   SupportTicket[]           @relation("SupportTicketAssignee")
  supportMessages          SupportTicketMessage[]
  supportAttachments       SupportTicketAttachment[]
  reviewedLinkReports      LinkReport[]              @relation("LinkReportReviewer")
  meta                     UserMeta[]
  bioPages                 BioPage[]
  accessLogs               LinkAccessLog[]
  accessLogReviews         AccessLogReview[]         @relation("AccessLogReviewedBy")
  createdAnnouncements     Announcement[]            @relation("AnnouncementCreatedBy")
  updatedAnnouncements     Announcement[]            @relation("AnnouncementUpdatedBy")
  announcementStates       AnnouncementUser[]
  updatedEmailSettings     EmailSettings[]           @relation("EmailSettingsUpdatedBy")
  createdEmailSenders      EmailSender[]             @relation("EmailSenderCreatedBy")
  updatedEmailSenders      EmailSender[]             @relation("EmailSenderUpdatedBy")
  createdEmailTemplates    EmailTemplate[]           @relation("EmailTemplateCreatedBy")
  updatedEmailTemplates    EmailTemplate[]           @relation("EmailTemplateUpdatedBy")
  emailPreferences         UserEmailPreference[]
  emailMessages            EmailMessage[]
  emailAuditLogs           AuditLog[]                @relation("AuditLogActor")

  @@index([status])
  @@index([monetizationLevelId])
  @@index([loyaltyTierId])
  @@index([referredById])
  @@map("users")
}

model UserMeta {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  key       String
  valueJson String   @map("value_json")
  valueType String   @default("json") @map("value_type")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([key])
  @@index([userId, updatedAt])
  @@map("user_meta")
}

model Role {
  id          Int                 @id @default(autoincrement())
  key         String              @unique
  name        String
  description String?
  isSystem    Boolean             @default(false) @map("is_system")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  permissions RoleHasPermission[]
  users       UserHasRole[]

  @@map("roles")
}

model Permission {
  id          Int                 @id @default(autoincrement())
  key         String              @unique
  name        String
  description String?
  group       String
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  roles       RoleHasPermission[]
  users       UserHasPermission[]

  @@index([group])
  @@map("permissions")
}

model RoleHasPermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_has_permissions")
}

model UserHasRole {
  roleId    Int      @map("role_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roleId, userId])
  @@index([userId])
  @@map("user_has_roles")
}

model UserHasPermission {
  permissionId Int        @map("permission_id")
  userId       Int        @map("user_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([permissionId, userId])
  @@index([userId])
  @@map("user_has_permissions")
}

model AuthSession {
  id                    String    @id @default(cuid())
  userId                Int       @map("user_id")
  authMethod            String    @default("password") @map("auth_method")
  impersonatorUserId    Int?      @map("impersonator_user_id")
  impersonatorSessionId String?   @map("impersonator_session_id")
  refreshTokenHash      String    @map("refresh_token_hash")
  rotationCounter       Int       @default(0) @map("rotation_counter")
  expiresAt             DateTime  @map("expires_at")
  revokedAt             DateTime? @map("revoked_at")
  userAgent             String?   @map("user_agent")
  ipAddress             String?   @map("ip_address")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([impersonatorUserId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      Int       @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  requestedIp String?   @map("requested_ip")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  requestedIp String?   @map("requested_ip")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model SocialAccount {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("social_accounts")
}

model Link {
  id                        Int             @id @default(autoincrement())
  userId                    Int             @map("user_id")
  slug                      String          @unique
  title                     String
  subtitle                  String?
  destinationType           String          @default("url") @map("destination_type")
  destinationUrl            String?         @map("destination_url")
  destinationFileId         Int?            @map("destination_file_id")
  destinationSnippetId      Int?            @map("destination_snippet_id")
  destinationSnippetContent String?         @map("destination_snippet_content")
  appearanceJson            String          @default("{}") @map("appearance")
  expiresAt                 DateTime?       @map("expires_at")
  maxClicks                 Int?            @map("max_clicks")
  views                     Int             @default(0)
  status                    String          @default("active")
  revenue                   Decimal         @default(0)
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @updatedAt @map("updated_at")
  deletedAt                 DateTime?       @map("deleted_at")
  user                      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  destinationFile           MemberFile?     @relation(fields: [destinationFileId], references: [id], onDelete: SetNull)
  destinationSnippet        Snippet?        @relation(fields: [destinationSnippetId], references: [id], onDelete: SetNull)
  actions                   LinkAction[]
  accessLogs                LinkAccessLog[]

  @@index([userId])
  @@index([userId, status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("stu_links")
}

model LinkAction {
  id        Int      @id @default(autoincrement())
  linkId    Int      @map("link_id")
  platform  String
  action    String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, position])
  @@map("stu_link_actions")
}

model UserAgent {
  id         Int             @id @default(autoincrement())
  hash       String          @unique
  raw        String
  browser    String          @default("other")
  os         String          @default("other")
  deviceType Int             @default(2) @map("device_type")
  accessLogs LinkAccessLog[]

  @@index([browser])
  @@index([os])
  @@index([deviceType])
  @@map("user_agents")
}

model LinkAccessLog {
  id               String           @id @default(cuid())
  linkId           Int              @map("link_id")
  userId           Int              @map("user_id")
  levelId          Int?             @map("level_id")
  agentHash        String           @map("agent_hash")
  ipAddress        String?          @map("ip_address")
  country          String           @default("ZZ")
  device           Int              @default(2)
  referrer         String?
  payoutCpm        Decimal          @default(0) @map("payout_cpm")
  revenue          Decimal          @default(0)
  isEarn           Boolean          @default(false) @map("is_earn")
  detectionMask    Int              @default(0) @map("detection_mask")
  rejectReasonMask Int              @default(0) @map("reject_reason_mask")
  completedAt      DateTime?        @map("completed_at")
  processedAt      DateTime?        @map("processed_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  link             Link             @relation(fields: [linkId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  userAgent        UserAgent        @relation(fields: [agentHash], references: [hash], onDelete: Restrict)
  review           AccessLogReview?

  @@index([createdAt])
  @@index([linkId, createdAt])
  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
  @@index([agentHash])
  @@index([completedAt, processedAt])
  @@index([userId, ipAddress, completedAt])
  @@index([userId, isEarn, completedAt])
  @@map("stu_access_logs")
}

model AccessLogReview {
  id           Int           @id @default(autoincrement())
  accessLogId  String        @unique @map("access_log_id")
  status       String
  note         String?
  reviewedById Int           @map("reviewed_by_id")
  reviewedAt   DateTime      @default(now()) @map("reviewed_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  accessLog    LinkAccessLog @relation(fields: [accessLogId], references: [id], onDelete: Cascade)
  reviewedBy   User          @relation("AccessLogReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([status, reviewedAt])
  @@index([reviewedById])
  @@map("stu_access_log_reviews")
}

model AccessLogAggregationRun {
  id             String    @id @default(cuid())
  minuteKey      String    @unique @map("minute_key")
  status         String    @default("processing")
  processedCount Int       @default(0) @map("processed_count")
  earnedViews    Int       @default(0) @map("earned_views")
  revenue        Decimal   @default(0)
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")

  @@index([startedAt])
  @@map("stu_access_aggregation_runs")
}

model MonetizationLevel {
  id           Int                            @id @default(autoincrement())
  key          String                         @unique
  status       String                         @default("draft")
  isDefault    Boolean                        @default(false) @map("is_default")
  sortOrder    Int                            @default(0) @map("sort_order")
  routesJson   String                         @default("[]") @map("routes")
  ratesJson    String                         @default("[]") @map("rates")
  metaDataJson String                         @default("{}") @map("meta_data")
  createdAt    DateTime                       @default(now()) @map("created_at")
  updatedAt    DateTime                       @updatedAt @map("updated_at")
  translations MonetizationLevelTranslation[]
  users        User[]

  @@index([status, sortOrder])
  @@map("stu_monetization_levels")
}

model MonetizationLevelTranslation {
  id          Int               @id @default(autoincrement())
  levelId     Int               @map("level_id")
  locale      String
  name        String
  description String?
  level       MonetizationLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([levelId, locale])
  @@index([locale])
  @@map("stu_monetization_level_translations")
}

model LoyaltyTier {
  id                Int                      @id @default(autoincrement())
  key               String                   @unique
  minimumValidViews Int                      @default(0) @map("minimum_valid_views")
  sortOrder         Int                      @default(0) @map("sort_order")
  iconKey           String?                  @map("icon_key")
  status            String                   @default("draft")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  translations      LoyaltyTierTranslation[]
  users             User[]

  @@index([status, sortOrder])
  @@index([status, minimumValidViews])
  @@map("loyalty_tiers")
}

model LoyaltyRollupRun {
  id              String    @id @default(cuid())
  dayKey          String    @unique @map("day_key")
  status          String    @default("processing")
  processedUsers  Int       @default(0) @map("processed_users")
  promotedUsers   Int       @default(0) @map("promoted_users")
  totalValidViews Int       @default(0) @map("total_valid_views")
  windowStartedAt DateTime  @map("window_started_at")
  windowEndedAt   DateTime  @map("window_ended_at")
  startedAt       DateTime  @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")

  @@index([startedAt])
  @@map("loyalty_rollup_runs")
}

model LoyaltyTierTranslation {
  id           Int         @id @default(autoincrement())
  tierId       Int         @map("tier_id")
  locale       String
  name         String
  description  String?
  benefitsJson String      @default("[]") @map("benefits")
  tier         LoyaltyTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@unique([tierId, locale])
  @@index([locale])
  @@map("loyalty_tier_translations")
}

model PaymentMethod {
  id                Int                        @id @default(autoincrement())
  withdrawFee       Decimal                    @default(0) @map("withdraw_fee")
  minWithdrawAmount Decimal                    @default(0) @map("min_withdraw_amount")
  status            String                     @default("draft")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  translations      PaymentMethodTranslation[]
  userMethods       UserPaymentMethod[]

  @@index([status])
  @@map("payment_methods")
}

model PaymentMethodTranslation {
  id              Int           @id @default(autoincrement())
  locale          String
  paymentMethodId Int           @map("payment_method_id")
  name            String?
  fieldsJson      String?       @map("fields")
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@unique([paymentMethodId, locale])
  @@index([locale])
  @@map("payment_method_translations")
}

model UserPaymentMethod {
  id              Int              @id @default(autoincrement())
  userId          Int              @map("user_id")
  paymentMethodId Int              @map("payment_method_id")
  detailsJson     String           @map("details")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod    @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  withdrawals     UserWithdrawal[]

  @@index([userId])
  @@index([paymentMethodId])
  @@map("user_payment_methods")
}

model UserWithdrawal {
  id                  Int                @id @default(autoincrement())
  userId              Int                @map("user_id")
  userPaymentMethodId Int?               @map("user_payment_method_id")
  amount              Decimal
  feeAmount           Decimal            @default(0) @map("fee_amount")
  netAmount           Decimal            @map("net_amount")
  currency            String             @default("USD")
  exchangeRate        Decimal            @default(1) @map("exchange_rate")
  status              String             @default("pending")
  paymentSnapshotJson String             @map("payment_snapshot")
  idempotencyKey      String             @unique @map("idempotency_key")
  statusReason        String?            @map("status_reason")
  processedById       Int?               @map("processed_by_id")
  processedAt         DateTime?          @map("processed_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  user                User               @relation("MemberWithdrawals", fields: [userId], references: [id], onDelete: Restrict)
  userPaymentMethod   UserPaymentMethod? @relation(fields: [userPaymentMethodId], references: [id], onDelete: SetNull)
  processedBy         User?              @relation("ProcessedWithdrawals", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([processedById])
  @@map("user_withdrawals")
}

model Commission {
  id                 Int      @id @default(autoincrement())
  userId             Int      @map("user_id")
  fromUserId         Int      @map("from_user_id")
  amount             Decimal
  rate               Decimal
  commissionableType String   @map("commissionable_type")
  commissionableId   Int      @map("commissionable_id")
  note               String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation("CommissionRecipient", fields: [userId], references: [id], onDelete: Cascade)
  fromUser           User     @relation("CommissionSource", fields: [fromUserId], references: [id], onDelete: Cascade)

  @@unique([commissionableType, commissionableId])
  @@index([userId, createdAt])
  @@index([fromUserId, createdAt])
  @@map("commissions")
}

model Language {
  id                   Int       @id @default(autoincrement())
  name                 String
  nativeName           String?   @map("native_name")
  locale               String    @unique
  code                 String    @unique
  regional             String?
  flag                 String?
  isDefault            Boolean   @default(false) @map("is_default")
  status               String    @default("draft")
  sortOrder            Int       @default(0) @map("order")
  isRtl                Boolean   @default(false) @map("is_rtl")
  uiMessagesJson       String    @default("{}") @map("ui_messages_json")
  uiCatalogSize        Int       @default(0) @map("ui_catalog_size")
  uiTranslationVersion Int       @default(1) @map("ui_translation_version")
  uiUpdatedAt          DateTime? @map("ui_updated_at")

  @@index([isDefault])
  @@index([status, sortOrder])
  @@map("languages")
}

model Currency {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  name          String
  symbol        String
  exchangeRate  Decimal  @default(1) @map("exchange_rate")
  decimalDigits Int      @default(2) @map("decimal_digits")
  isBase        Boolean  @default(false) @map("is_base")
  isDefault     Boolean  @default(false) @map("is_default")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isBase])
  @@index([isDefault])
  @@index([isActive, sortOrder])
  @@map("currencies")
}

model WebsiteMenu {
  id                    Int                      @id @default(autoincrement())
  key                   String                   @unique
  name                  String
  description           String?
  status                String                   @default("draft")
  draftVersion          Int                      @default(1) @map("draft_version")
  publishedVersion      Int                      @default(0) @map("published_version")
  publishedSnapshotJson String?                  @map("published_snapshot_json")
  publishedAt           DateTime?                @map("published_at")
  createdById           Int?                     @map("created_by_id")
  updatedById           Int?                     @map("updated_by_id")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  deletedAt             DateTime?                @map("deleted_at")
  createdBy             User?                    @relation("WebsiteMenuCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy             User?                    @relation("WebsiteMenuUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  translations          WebsiteMenuTranslation[]
  items                 WebsiteMenuItem[]
  locations             WebsiteMenuLocation[]

  @@index([status, updatedAt])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
  @@map("website_menus")
}

model WebsiteMenuTranslation {
  id        Int         @id @default(autoincrement())
  menuId    Int         @map("menu_id")
  locale    String
  title     String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  menu      WebsiteMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([menuId, locale])
  @@index([locale])
  @@map("website_menu_translations")
}

model WebsiteMenuItem {
  id           Int                          @id @default(autoincrement())
  menuId       Int                          @map("menu_id")
  parentId     Int?                         @map("parent_id")
  pageId       Int?                         @map("page_id")
  type         String                       @default("CUSTOM_URL")
  url          String?
  target       String                       @default("SELF")
  rel          String?
  iconKey      String?                      @map("icon_key")
  isEnabled    Boolean                      @default(true) @map("is_enabled")
  sortOrder    Int                          @default(0) @map("sort_order")
  createdAt    DateTime                     @default(now()) @map("created_at")
  updatedAt    DateTime                     @updatedAt @map("updated_at")
  deletedAt    DateTime?                    @map("deleted_at")
  menu         WebsiteMenu                  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent       WebsiteMenuItem?             @relation("WebsiteMenuItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     WebsiteMenuItem[]            @relation("WebsiteMenuItemTree")
  page         Page?                        @relation(fields: [pageId], references: [id], onDelete: Restrict)
  translations WebsiteMenuItemTranslation[]

  @@index([menuId, parentId, sortOrder])
  @@index([pageId])
