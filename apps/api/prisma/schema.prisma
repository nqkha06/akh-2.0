  deliveredAt       DateTime?           @map("delivered_at")
  openedAt          DateTime?           @map("opened_at")
  clickedAt         DateTime?           @map("clicked_at")
  bouncedAt         DateTime?           @map("bounced_at")
  complainedAt      DateTime?           @map("complained_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  template          EmailTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sender            EmailSender?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  events            EmailMessageEvent[]

  @@index([status, createdAt])
  @@index([recipientEmail])
  @@index([providerMessageId])
  @@index([emailType, createdAt])
  @@index([templateId, createdAt])
  @@index([senderId, createdAt])
  @@index([userId])
  @@index([campaignId])
  @@map("email_messages")
}

model EmailMessageEvent {
  id              String       @id @default(cuid())
  emailMessageId  String       @map("email_message_id")
  eventType       String       @map("event_type")
  providerEventId String?      @map("provider_event_id")
  payload         Json
  occurredAt      DateTime     @map("occurred_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  emailMessage    EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@unique([providerEventId, eventType])
  @@index([emailMessageId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("email_message_events")
}

model EmailSuppression {
  id                 String   @id @default(cuid())
  emailAddress       String   @unique @map("email_address")
  reason             String
  source             String
  providerEventId    String?  @map("provider_event_id")
  lastEmailMessageId String?  @map("last_email_message_id")
  suppressedAt       DateTime @default(now()) @map("suppressed_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([reason, suppressedAt])
  @@map("email_suppressions")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  Int?     @map("actor_user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  previousData Json?    @map("previous_data")
  newData      Json?    @map("new_data")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")
  actor        User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
