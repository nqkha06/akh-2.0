{
  "name": "stu-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "web:dev": "turbo dev --filter=@stu/web",
    "web:build": "turbo build --filter=@stu/web",
    "api:dev": "turbo dev --filter=@stu/api",
    "api:build": "turbo build --filter=@stu/api",
    "api:start": "pnpm --filter @stu/api start",
    "test:auth": "pnpm --filter @stu/api test:e2e",
    "prisma:generate": "pnpm --filter @stu/api prisma:generate",
    "prisma:migrate": "pnpm --filter @stu/api prisma:migrate",
    "prisma:seed": "pnpm --filter @stu/contracts build && pnpm --filter @stu/api prisma:seed",
    "prisma:studio": "pnpm --filter @stu/api prisma:studio"
  },
  "devDependencies": {
    "turbo": "^2.10.5"
  }
}
