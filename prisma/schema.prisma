generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              Int             @id @default(autoincrement())
  name            String
  email           String          @unique
  emailVerifiedAt DateTime?       @map("email_verified_at")
  passwordHash    String?         @map("password")
  avatar          String?
  status          String          @default("active")
  role            String          @default("member")
  tokenVersion    Int             @default(0) @map("token_version")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  socialAccounts  SocialAccount[]
  authSessions    AuthSession[]
  links           Link[]

  @@index([status])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           Int       @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  rotationCounter  Int       @default(0) @map("rotation_counter")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model SocialAccount {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("social_accounts")
}

model Link {
  id                   Int          @id @default(autoincrement())
  userId               Int          @map("user_id")
  slug                 String       @unique
  title                String
  subtitle             String?
  destinationType      String       @default("url") @map("destination_type")
  destinationUrl       String?      @map("destination_url")
  destinationFileId    String?      @map("destination_file_id")
  destinationSnippetId String?      @map("destination_snippet_id")
  appearanceJson       String       @default("{}") @map("appearance")
  expiresAt            DateTime?    @map("expires_at")
  maxClicks            Int?         @map("max_clicks")
  clicks               Int          @default(0)
  status               String       @default("active")
  levelId              Int?         @map("level_id")
  revenue              Decimal      @default(0)
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  deletedAt            DateTime?    @map("deleted_at")
  user                 User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  destinationFile      ManagedFile? @relation(fields: [destinationFileId], references: [id], onDelete: SetNull)
  destinationSnippet   Snippet?     @relation(fields: [destinationSnippetId], references: [id], onDelete: SetNull)
  actions              LinkAction[]

  @@index([userId])
  @@index([userId, status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("stu_links")
}

model LinkAction {
  id        Int      @id @default(autoincrement())
  linkId    Int      @map("link_id")
  platform  String
  action    String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, position])
  @@map("stu_link_actions")
}

model Snippet {
  id               String   @id @default(cuid())
  name             String
  content          String
  copies           Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  destinationLinks Link[]

  @@index([createdAt])
}

model ManagedFile {
  id               String    @id @default(cuid())
  alias            String    @unique
  name             String
  originalName     String
  extension        String?
  mimeType         String
  size             Int
  path             String
  isPublic         Boolean   @default(true)
  downloadCount    Int       @default(0)
  status           String    @default("completed")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  destinationLinks Link[]

  @@index([createdAt])
  @@index([deletedAt])
  @@index([status])
}

model BioPage {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  title                String?
  status               String   @default("published")
  buttonStyle          String   @default("rounded")
  backgroundColor      String   @default("#ffffff")
  backgroundImage      String?
  backgroundMediaType  String?
  backgroundMediaUrl   String?
  selectedBackgroundId String?
  socialLinksJson      String   @default("[]")
  customLinksJson      String   @default("[]")
  widgetsJson          String   @default("[]")
  hiddenLinksJson      String   @default("[]")
  views                Int      @default(0)
  clicks               Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}
