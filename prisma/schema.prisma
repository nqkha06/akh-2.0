generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              Int             @id @default(autoincrement())
  name            String
  email           String          @unique
  emailVerifiedAt DateTime?       @map("email_verified_at")
  passwordHash    String?         @map("password")
  avatar          String?
  status          String          @default("active")
  role            String          @default("member")
  tokenVersion    Int             @default(0) @map("token_version")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  socialAccounts  SocialAccount[]

  @@index([status])
  @@map("users")
}

model SocialAccount {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("social_accounts")
}

model Link {
  id                     String       @id @default(cuid())
  slug                   String       @unique
  destinationUrl         String
  title                  String
  inputType              String       @default("url")
  selectedSnippet        String?
  selectedFile           String?
  subtitle               String?
  customAlias            String?      @unique
  coverImageUrl          String?
  expiryEnabled          Boolean      @default(false)
  expiryType             String?
  expiryDate             DateTime?
  expiryTime             String?
  maxClicks              Int?
  selectedBackgroundId   String?
  selectedBackgroundName String?
  backgroundMediaType    String?
  backgroundMediaUrl     String?
  sameAsCoverImage       Boolean      @default(false)
  opacity                Int          @default(100)
  blur                   Int          @default(0)
  saturation             Int          @default(100)
  contrast               Int          @default(100)
  grayscale              Int          @default(0)
  clicks                 Int          @default(0)
  status                 String       @default("active")
  actions                LinkAction[]
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

model LinkAction {
  id        String   @id @default(cuid())
  linkId    String
  platform  String
  action    String
  url       String
  createdAt DateTime @default(now())
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
}

model Snippet {
  id        String   @id @default(cuid())
  name      String
  content   String
  copies    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model ManagedFile {
  id            String    @id @default(cuid())
  alias         String    @unique
  name          String
  originalName  String
  extension     String?
  mimeType      String
  size          Int
  path          String
  isPublic      Boolean   @default(true)
  downloadCount Int       @default(0)
  status        String    @default("completed")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([createdAt])
  @@index([deletedAt])
  @@index([status])
}

model BioPage {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  title           String?
  status          String   @default("published")
  buttonStyle     String   @default("rounded")
  backgroundColor String   @default("#ffffff")
  backgroundImage String?
  backgroundMediaType String?
  backgroundMediaUrl  String?
  selectedBackgroundId String?
  socialLinksJson String   @default("[]")
  customLinksJson String   @default("[]")
  widgetsJson     String   @default("[]")
  hiddenLinksJson String   @default("[]")
  views           Int      @default(0)
  clicks          Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}
